# Public origin used in canonical URLs, sitemap, Open Graph, and JSON-LD.
# Must be an http(s) origin. Do not put credentials in this value.
NEXT_PUBLIC_SITE_URL=https://www.cidus.example

# Optional server-only HTTPS endpoint that receives validated contact JSON.
# Leave unset to accept inquiries without delivery (nothing is stored).
# Do not prefix with NEXT_PUBLIC_ — this must never ship to the browser.
CONTACT_WEBHOOK_URL=

# Single switch for the CIDUS maintenance screen.
# true  — render ONLY the maintenance UI (Home/About/Services/Clients/Contact/nav/footer are not mounted)
# false — or unset: the normal one-page site
#
# Production code defaults to off unless this is explicitly "true".
# Copy to .env.local for your machine. `next dev` also reads .env.development.
NEXT_PUBLIC_MAINTENANCE_MODE=true
